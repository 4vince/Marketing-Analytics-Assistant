# AI service environment template — lists API keys and model configuration.
OPENCODE_API_KEY=sk...
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=opencode
LLM_MODEL=big-pickle

# Scoped database connections for the chat agents.
# Roles/views are created automatically at startup using DATABASE_URL.
# Default dev passwords (created by the bootstrap):
#   storefront_user / storefront_dev_only
#   admin_user      / admin_dev_only
# Local dev (Postgres on localhost):
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce
DATABASE_URL_STOREFRONT=postgresql://storefront_user:storefront_dev_only@localhost:5432/ecommerce
DATABASE_URL_ADMIN=postgresql://admin_user:admin_dev_only@localhost:5432/ecommerce
